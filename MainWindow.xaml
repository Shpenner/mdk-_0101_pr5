<Window x:Class="pr5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinHeight="450" MinWidth="800" FontFamily="Arial Narrow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель с кнопкой добавления -->
        <Border Grid.Row="0" Background="#35363A" Padding="10">
            <Button x:Name="btnAdd" Content="Добавить студента"
                Width="180" Height="35" HorizontalAlignment="Left"
                Background="#4CAF50" Foreground="White" BorderThickness="0"
                FontSize="14" Cursor="Hand"
                Click="btnAdd_Click"/>
        </Border>

        <ScrollViewer Grid.Row="1" ScrollChanged="ScrollViewer_ScrollChanged">
            <StackPanel Margin="10" x:Name="parent">

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
